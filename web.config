<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="server_v2.js" verb="*" modules="iisnode"/>
    </handlers>
    <defaultDocument enabled="false" />
    <rewrite>
      <rules>
        <!-- All requests route to node server_v2.js with zero-cache dynamic asset serving -->
        <rule name="DynamicContent">
          <match url=".*" />
          <action type="Rewrite" url="server_v2.js"/>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode
      nodeProcessCommandLine="node.exe"
      maxConcurrentRequestsPerProcess="1024"
      watchedFiles="web.config;app.js;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      flushResponse="true"
      enableXFF="true" />
  </system.webServer>
</configuration>
